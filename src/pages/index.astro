---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import OrbitBadge from "../components/OrbitBadge.astro";
import headshot from "../assets/adonias-headshot-800.webp";
import Ticker from "../components/Ticker.astro";
import MetricsLedger from "../components/MetricsLedger.astro";
import WorkLedger from "../components/WorkLedger.astro";
import Testimonial from "../components/Testimonial.astro";
import TimezoneChart from "../components/TimezoneChart.astro";

const work = (await getCollection("work", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const workRows = work.map((entry) => ({
  href: `/work/${entry.id}/`,
  tag: entry.data.tag,
  client: entry.data.client,
  title: entry.data.title,
  period: entry.data.period,
}));

const metrics = [
  { prefix: "$", value: 22, suffix: "K", label: "monthly recurring revenue grown across a SaaS product portfolio" },
  { value: 300, suffix: "%", label: "lift in client lead generation for a real-estate client" },
  { prefix: "100 to ", value: 500, label: "B2B customers grown in 12 months" },
  { value: 70, suffix: "%", label: "execution time cut with AI-driven workflows" },
];

const services = [
  {
    title: "Customer acquisition",
    body: "Cold email outbound, paid social and paid search, demand generation. I build the system, write the copywriting, and manage it to a CAC target.",
  },
  {
    title: "SEO and content strategy",
    body: "Keyword research, editorial planning, blog production, technical SEO. Content that ranks and sells.",
  },
  {
    title: "Funnels and CRO",
    body: "Landing pages, A/B testing, activation and retention flows, analytics wired end to end in GA4 and HubSpot.",
  },
  {
    title: "AI-powered marketing systems",
    body: "n8n and LLM workflows that cut execution time by about 70%. I build the internal AI tools instead of hiring more hands.",
  },
];
---

<Base
  title="Adonias Nigussie | Marketing & Growth Strategist"
  description="Adonias Nigussie is a marketing and growth strategist who builds the SEO, content, paid, and AI systems that turn strategy into revenue. Experience across Estonia, the UK, Italy, and Ethiopia."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <h1 id="hero-title" class="display rise" style="--d:0ms">
        I build the systems that <span class="uline">grow businesses.</span>
      </h1>
      <p class="hero-sub rise" style="--d:120ms">
        I'm <strong>Adonias Nigussie</strong>, a marketing and growth strategist.
        I build the SEO, content, paid, and AI systems that turn strategy into
        revenue, and I have done it with companies across Estonia, the UK, Italy,
        and Ethiopia.
      </p>
      <div class="hero-actions rise" style="--d:240ms">
        <a class="btn btn-primary" href="/work/">See my work</a>
        <a class="btn btn-secondary" href="/contact/">Get in touch</a>
      </div>
      <figure class="hero-photo rise" style="--d:300ms">
        <div class="photo-frame" data-tilt>
          <Image
            src={headshot}
            alt="Adonias Nigussie, marketing and growth strategist, arms crossed in a blue suit"
            width={520}
            height={520}
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <p class="sticker hero-sticker">
          <span class="place">Based in Addis Ababa</span>
          <span class="zone">Working with teams internationally</span>
        </p>
        <div class="hero-badge">
          <OrbitBadge />
        </div>
      </figure>
    </div>
  </section>

  <Ticker />

  <MetricsLedger metrics={metrics} />

  <section class="work" aria-labelledby="work-title">
    <div class="wrap">
      <h2 id="work-title" class="section-title display" data-reveal>
        Selected <span class="uline">work</span>
      </h2>
      <WorkLedger rows={workRows} />
    </div>
  </section>

  <section class="services" aria-labelledby="services-title">
    <div class="wrap">
      <h2 id="services-title" class="section-title display" data-reveal>
        What I <span class="uline">do</span>
      </h2>
      <dl class="service-list">
        {
          services.map((service, i) => (
            <div class="service-row" data-reveal style={`--d:${i * 70}ms`}>
              <dt class="display">{service.title}</dt>
              <dd>{service.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="testimonials" aria-labelledby="testimonials-title">
    <h2 id="testimonials-title" class="sr-only">What clients say</h2>
    <div class="wrap quote-stack">
      <Testimonial
        quote="Adonias has helped us attract over 400 new clients through SEO and social media in just a span of 1 year and 3 months."
        source="SMS Ethiopia"
        rotate={-1}
      />
      <Testimonial
        quote="We have worked with Adonias for over 2 years and he has used his expertise to guide our business efforts."
        source="Jaktech Engineering & Trading PLC"
        rotate={1}
        delay={80}
      />
      <Testimonial
        quote="Top-3 search rankings delivered across 14 target keywords."
        source="Recognise Design, UK"
        rotate={-1}
        quoted={false}
        delay={160}
      />
    </div>
  </section>

  <section class="remote" aria-labelledby="remote-title">
    <div class="wrap remote-grid">
      <div class="remote-copy" data-reveal>
        <h2 id="remote-title" class="section-title display">Built to work with <span class="uline">teams anywhere.</span></h2>
        <p>
          I have run marketing and growth for companies in Estonia, the UK,
          Italy, and Ethiopia. I work on Slack, Notion, Jira, and GitHub, with
          async standups and documentation people actually read, and my hours
          overlap cleanly with both US and European business days.
        </p>
      </div>
      <TimezoneChart />
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(3.5rem, 8vw, 6rem);
  }
  .hero-grid {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 8vw, 5.4rem);
    line-height: 1.02;
    max-width: 13ch;
    text-transform: uppercase;
  }
  .hero-sub {
    max-width: 56ch;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: var(--ink-soft);
    text-wrap: pretty;
  }
  .hero-sub strong {
    color: var(--ink);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .hero-photo {
    position: relative;
    margin: 1.5rem 0 0;
    max-width: min(21rem, 82%);
    rotate: -1.2deg;
  }
  .photo-frame {
    border: var(--line);
    border-radius: 2px;
    box-shadow: var(--shadow-tomato);
    background: var(--sand-deep);
  }
  .photo-frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero-sticker {
    position: absolute;
    top: -1.1rem;
    right: -0.9rem;
    transform: rotate(4deg);
  }
  .hero-badge {
    position: absolute;
    bottom: -2.2rem;
    left: -2rem;
  }
  /* Scroll-driven drift: sticker and badge ease downward as you scroll
     past the hero. Uses `translate` so it never fights the rotations. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .hero-sticker,
      .hero-badge {
        animation: hero-drift linear both;
        animation-timeline: scroll();
        animation-range: 0 100vh;
      }
      .hero-badge {
        animation-name: hero-drift-deep;
      }
    }
  }
  @keyframes hero-drift {
    to {
      translate: 0 26px;
    }
  }
  @keyframes hero-drift-deep {
    to {
      translate: 0 44px;
    }
  }
  @media (min-width: 60rem) {
    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(19rem, 1fr);
      grid-template-areas:
        "title photo"
        "sub   photo"
        "cta   photo";
      column-gap: clamp(3rem, 6vw, 5rem);
      align-items: start;
    }
    .hero h1 {
      grid-area: title;
    }
    .hero-sub {
      grid-area: sub;
    }
    .hero-actions {
      grid-area: cta;
      align-self: end;
    }
    .hero-photo {
      grid-area: photo;
      margin: 0.5rem 0 0;
      max-width: 24rem;
      justify-self: end;
    }
  }

  /* ---------- Work ---------- */
  .work {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  /* ---------- Services ---------- */
  .services {
    background: var(--sand-deep);
    border-top: var(--line);
    border-bottom: var(--line);
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }
  .service-list {
    margin: 0;
    border-bottom: var(--line-thin);
  }
  .service-row {
    border-top: var(--line-thin);
    padding: 1.4rem 0.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .service-row dt {
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    line-height: 1.2;
    text-transform: uppercase;
  }
  .service-row dd {
    margin: 0;
    color: var(--ink-soft);
    max-width: 58ch;
    text-wrap: pretty;
  }
  @media (min-width: 60rem) {
    .service-row {
      display: grid;
      grid-template-columns: minmax(16rem, 1fr) 2fr;
      column-gap: 3rem;
      align-items: start;
      padding: 1.9rem 0.5rem;
    }
  }

  /* ---------- Testimonials ---------- */
  .testimonials {
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(4rem, 9vw, 7rem);
  }
  .quote-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3rem);
  }
  .quote-stack > :global(.quote-block) {
    max-width: 46rem;
  }
  @media (min-width: 60rem) {
    .quote-stack > :global(.quote-block:nth-child(2)) {
      align-self: flex-end;
    }
    .quote-stack > :global(.quote-block:nth-child(3)) {
      align-self: center;
      max-width: 38rem;
    }
  }

  /* ---------- Remote readiness ---------- */
  .remote {
    background: var(--sand-deep);
    border-top: var(--line);
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }
  .remote-grid {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .remote-copy .section-title {
    margin-bottom: 1.5rem;
    max-width: 16ch;
  }
  .remote-copy p {
    max-width: 54ch;
    color: var(--ink-soft);
    text-wrap: pretty;
  }
  .remote :global(.overlap) {
    background: var(--sand);
  }
  @media (min-width: 60rem) {
    .remote-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(22rem, 1fr);
      column-gap: 4rem;
      align-items: center;
    }
    .remote :global(.overlap) {
      justify-self: end;
    }
  }
</style>
