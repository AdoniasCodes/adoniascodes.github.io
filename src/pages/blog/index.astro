---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const iso = (date: Date) => date.toISOString().slice(0, 10);
const nice = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---

<Base
  title="Blog: SEO, AI Search & Growth Marketing | Adonias Nigussie"
  description="Practical writing on SEO, AI search visibility, marketing measurement, and AI-driven growth systems, backed by sourced data and real client work."
>
  <section class="blog-index">
    <div class="wrap-narrow">
      <header>
        <h1 class="page-title display rise" style="--d:0ms">
          The <span class="mark-hl">blog</span>
        </h1>
        <p class="intro rise" style="--d:120ms">
          Notes from the work: SEO, AI search, measurement, and the systems I build to grow
          businesses. Every number links to its source.
        </p>
      </header>
      <ol class="posts">
        {
          posts.map((p) => (
            <li data-reveal>
              <a href={`/blog/${p.id}/`}>
                <time datetime={iso(p.data.pubDate)}>{nice(p.data.pubDate)}</time>
                <h2 class="display">{p.data.title}</h2>
                <p>{p.data.description}</p>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .blog-index {
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(4rem, 9vw, 7rem);
  }
  .intro {
    margin-top: 1.4rem;
    max-width: 52ch;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .posts {
    list-style: none;
    padding: 0;
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    border-bottom: var(--line);
  }
  .posts li {
    border-top: var(--line);
  }
  .posts a {
    display: block;
    padding: 1.6rem 0.25rem;
    text-decoration: none;
    color: inherit;
  }
  .posts time {
    font-size: 0.78rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--signal-deep);
  }
  .posts h2 {
    margin-top: 0.4rem;
    font-size: clamp(1.25rem, 2.8vw, 1.7rem);
    line-height: 1.15;
    text-wrap: balance;
    border-bottom: 3px solid transparent;
    display: inline;
    transition: border-color 0.18s ease-out;
  }
  .posts a:hover h2 {
    border-bottom-color: var(--signal);
  }
  .posts p {
    margin-top: 0.7rem;
    color: var(--ink-2);
    max-width: 62ch;
    text-wrap: pretty;
  }
  @media (prefers-reduced-motion: reduce) {
    .posts h2 {
      transition: none;
    }
  }
</style>
