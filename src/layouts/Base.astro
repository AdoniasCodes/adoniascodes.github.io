---
import Seo from "../components/Seo.astro";
import PersonSchema from "../components/PersonSchema.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import fontLatin from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: string;
  page?: string;
}

const { title, description, ogImage, type, page = "inner" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ec5022" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} ogImage={ogImage} type={type} />
    <PersonSchema />
    <script is:inline>
      /* Arms the motion gate before first paint; reduced-motion CSS
         overrides it, and content stays visible without JS. */
      document.documentElement.classList.add("js");
      /* Safety net: if the motion bundle never runs, show everything anyway */
      setTimeout(function () {
        document.documentElement.classList.add("loaded");
      }, 2500);
    </script>
    <slot name="head" />
  </head>
  <body class={`page-${page}`}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav tone={page === "home" ? "signal" : "base"} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/reveal.js";
      import "../scripts/motion.js";
      import "../scripts/scroll.js";
    </script>
  </body>
</html>
