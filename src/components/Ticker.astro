---
const skills = [
  "Cold Email Outbound",
  "Paid Social",
  "Google Ads",
  "SEO",
  "CRO",
  "A/B Testing",
  "GA4",
  "HubSpot",
  "n8n",
  "AI Workflows",
];
---

<div class="ticker-clip">
<div class="ticker" data-ticker>
  <div class="ticker-track" aria-hidden="true">
    {
      [0, 1].map(() => (
        <span class="run">
          {skills.map((s) => (
            <>
              <span class="item">{s}</span>
              <span class="dot" />
            </>
          ))}
        </span>
      ))
    }
  </div>
  <p class="sr-only">Skills: {skills.join(", ")}.</p>
</div>
</div>

<style>
  .ticker-clip {
    position: relative;
    z-index: var(--z-content);
    overflow-x: clip;
  }
  .ticker {
    position: relative;
    z-index: var(--z-content);
    background: var(--ink);
    color: var(--on-ink);
    overflow: hidden;
    padding-block: 1.05rem;
    transform: rotate(-1.6deg) scale(1.04);
    margin-block: -1.2rem;
    border-block: 2px solid var(--ink);
  }
  .ticker-track {
    display: flex;
    width: max-content;
    animation: marquee 36s linear infinite;
    will-change: transform;
  }
  /* scroll.js takes over and couples speed to scroll velocity */
  .ticker:global(.is-driven) .ticker-track {
    animation: none;
  }
  .run {
    flex: none;
    display: flex;
    align-items: center;
  }
  .item {
    font-weight: 860;
    font-stretch: 125%;
    font-size: clamp(1.1rem, 2.4vw, 1.6rem);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    white-space: nowrap;
    padding-inline: 1.1rem;
  }
  .dot {
    flex: none;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--signal);
  }
  .item:nth-child(4n + 1) {
    color: var(--amber);
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }
  }
</style>
