---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import OrbitBadge from "./OrbitBadge.astro";
import headshot from "../assets/adonias-headshot-800.webp";
import Ticker from "./Ticker.astro";
import MetricsLedger from "./MetricsLedger.astro";
import WorkLedger from "./WorkLedger.astro";
import Testimonial from "./Testimonial.astro";
import TimezoneChart from "./TimezoneChart.astro";

const work = (await getCollection("work", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const workRows = work.map((entry) => ({
  href: `/work/${entry.id}/`,
  tag: entry.data.tag,
  client: entry.data.client,
  title: entry.data.title,
  period: entry.data.period,
  teaser: entry.data.teaser,
}));

const metrics = [
  { prefix: "$", value: 22, suffix: "K", label: "monthly recurring revenue grown across a SaaS product portfolio" },
  { value: 300, suffix: "%", label: "lift in client lead generation for a real-estate client" },
  { prefix: "100 to ", value: 500, label: "B2B customers grown in 12 months" },
  { value: 70, suffix: "%", label: "execution time cut with AI-driven workflows" },
];

const services = [
  {
    title: "Customer acquisition",
    body: "Cold email outbound, paid social and paid search, demand generation. I build the system, write the copywriting, and manage it to a CAC target.",
  },
  {
    title: "SEO and content strategy",
    body: "Keyword research, editorial planning, blog production, technical SEO. Content that ranks and sells.",
  },
  {
    title: "Funnels and CRO",
    body: "Landing pages, A/B testing, activation and retention flows, analytics wired end to end in GA4 and HubSpot.",
  },
  {
    title: "AI-powered marketing systems",
    body: "n8n and LLM workflows that cut execution time by about 70%. I build the internal AI tools instead of hiring more hands.",
  },
];

/* Markets on the globe: where the work has actually been */
const markets = [
  { name: "Estonia", lat: 58.6, lon: 25.0 },
  { name: "UK", lat: 52.5, lon: -1.5 },
  { name: "Italy", lat: 42.8, lon: 12.5 },
];

const words = ["I", "build", "the", "systems", "that"];

interface Props {
  hero?: "funnel" | "terrain" | "curve";
  noindex?: boolean;
}
const { hero = "funnel", noindex = false } = Astro.props;

/* Milestones on the "curve" hero: the same four verified results as the metrics band */
const milestones = ["$22K MRR", "300% more leads", "100 to 500 customers", "70% faster execution"];
---

<Base
  title="Adonias Nigussie | Marketing & Growth Strategist"
  description="Adonias Nigussie is a marketing and growth strategist who builds the SEO, content, paid, and AI systems that turn strategy into revenue. Experience across Estonia, the UK, Italy, and Ethiopia."
  page="home"
  navTone={hero === "curve" ? "dark" : hero === "terrain" ? "base" : "signal"}
  noindex={noindex}
>
  <section class={`hero hero--${hero}`} aria-labelledby="hero-title" data-hero data-variant={hero}>
    <div class="hero-scene" data-scene aria-hidden="true">
      <canvas></canvas>
      {hero === "funnel" && (
        <>
          <span class="scene-label label-leads" data-label-leads>Leads in</span>
          <span class="scene-label label-revenue" data-label-revenue>Revenue out</span>
        </>
      )}
      {hero === "curve" &&
        milestones.map((m) => <span class="scene-label ms-label" data-ms-label>{m}</span>)}
    </div>

    <div class="wrap hero-grid">
      <h1 id="hero-title" class="hero-title">
        {
          words.map((w, i) => (
            <>
              <span class="wm">
                <span class="w" style={`--i:${i}`}>{w}</span>
              </span>{" "}
            </>
          ))
        }
        <span class="hl"><span class="wm"><span class="w" style="--i:5">grow</span></span>{" "}<span class="wm"><span class="w" style="--i:6">businesses.</span></span></span>
      </h1>

      <div class="hero-sub rise" style="--d:520ms">
        {hero === "curve" && (
          <span class="avatar" data-tilt>
            <Image src={headshot} alt="" width={120} height={120} loading="eager" />
          </span>
        )}
        <p>
        I'm <strong>Adonias Nigussie</strong>, a marketing and growth strategist.
        I build the SEO, content, paid, and AI systems that turn strategy into
        revenue, and I have done it with companies across Estonia, the UK, Italy,
        and Ethiopia.
      
        </p>
      </div>

      <div class="hero-actions rise" style="--d:640ms">
        <a class="btn btn-primary" href="/work/">See my work <span class="arrow" aria-hidden="true">&rarr;</span></a>
        <a class="btn btn-secondary" href="/contact/">Get in touch</a>
        <a class="cv-link" href="/Adonias-Nigussie-CV.pdf" download>
          Download CV <span aria-hidden="true">&#8595;</span>
        </a>
      </div>

      {hero !== "curve" && (
      <figure class="hero-photo rise" style="--d:380ms" data-anchor>
        <div class="photo-frame" data-tilt>
          <Image
            src={headshot}
            alt="Adonias Nigussie, marketing and growth strategist, arms crossed in a blue suit"
            width={520}
            height={520}
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <p class="sticker hero-sticker">
          <span class="place">Based in Addis Ababa</span>
          <span class="zone">Working with teams internationally</span>
        </p>
        <div class="hero-badge">
          <OrbitBadge />
        </div>
      </figure>
      )}
    </div>
  </section>

  <Ticker />

  <MetricsLedger metrics={metrics} />

  <section class="work" aria-labelledby="work-title">
    <div class="wrap">
      <h2 id="work-title" class="section-title display" data-stretch>
        Selected <span class="mark-hl">work</span>
      </h2>
      <WorkLedger rows={workRows} />
    </div>
  </section>

  <section class="services" aria-labelledby="services-title">
    <div class="wrap">
      <h2 id="services-title" class="section-title display" data-stretch>
        What I <span class="mark-hl">do</span>
      </h2>
      <dl class="svc-stack" data-stack>
        {
          services.map((service, i) => (
            <div class:list={["svc", `svc-${i}`]} style={`--k:${i}`}>
              <dt class="display">{service.title}</dt>
              <dd>{service.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="testimonials" aria-labelledby="testimonials-title">
    <h2 id="testimonials-title" class="sr-only">What clients say</h2>
    <div class="wrap quote-stack">
      <Testimonial
        quote="Adonias has helped us attract over 400 new clients through SEO and social media in just a span of 1 year and 3 months."
        source="SMS Ethiopia"
        rotate={-1}
        tone="signal"
      />
      <Testimonial
        quote="We have worked with Adonias for over 2 years and he has used his expertise to guide our business efforts."
        source="Jaktech Engineering & Trading PLC"
        rotate={1}
        delay={80}
      />
      <Testimonial
        quote="Top-3 search rankings delivered across 14 target keywords."
        source="Recognise Design, UK"
        rotate={-1}
        quoted={false}
        delay={160}
        tone="amber"
      />
    </div>
  </section>

  <section class="remote" aria-labelledby="remote-title">
    <div class="wrap remote-grid">
      <div class="remote-copy">
        <h2 id="remote-title" class="section-title display" data-stretch>
          Built to work with <span class="mark-hl">teams anywhere.</span>
        </h2>
        <p data-reveal>
          I have run marketing and growth for companies in Estonia, the UK,
          Italy, and Ethiopia. I work on Slack, Notion, Jira, and GitHub, with
          async standups and documentation people actually read, and my hours
          overlap cleanly with both US and European business days.
        </p>
        <TimezoneChart />
      </div>
      <div
        class="globe"
        data-globe
        data-markets={JSON.stringify(markets)}
        role="img"
        aria-label="Globe with arcs from Addis Ababa to Estonia, the UK, and Italy"
        tabindex="0"
      >
        <canvas></canvas>
        {markets.map((m) => <span class="g-label" data-g-label>{m.name}</span>)}
        <span class="g-label g-home" data-g-label>Addis Ababa</span>
        <span class="g-hint" aria-hidden="true">Drag to spin</span>
      </div>
    </div>
  </section>
</Base>

<script>
  /* 3D scenes load well after first paint so they never compete with the
     LCP or the main thread during load */
  const idle = (fn: () => void) => {
    let fired = false;
    const go = () => {
      if (fired) return;
      fired = true;
      "requestIdleCallback" in window
        ? (window as any).requestIdleCallback(fn, { timeout: 1500 })
        : setTimeout(fn, 200);
    };
    ["pointermove", "scroll", "touchstart", "keydown"].forEach((ev) =>
      addEventListener(ev, go, { once: true, passive: true }),
    );
    const later = () => setTimeout(go, 2500);
    document.readyState === "complete" ? later() : addEventListener("load", later, { once: true });
  };

  const supportsGL = (() => {
    try {
      const c = document.createElement("canvas");
      return !!(c.getContext("webgl2") || c.getContext("webgl"));
    } catch {
      return false;
    }
  })();

  if (supportsGL) {
    const host = document.querySelector<HTMLElement>("[data-scene]");
    const variant = document.querySelector<HTMLElement>("[data-hero]")?.dataset.variant;
    const scenes: Record<string, () => Promise<any>> = {
      funnel: () => import("../scripts/growth-engine.js"),
      terrain: () => import("../scripts/hero-terrain.js"),
      curve: () => import("../scripts/hero-curve.js"),
    };
    if (host && variant && scenes[variant]) {
      idle(async () => {
        const { mount } = await scenes[variant]();
        mount(host, {
          anchor: document.querySelector("[data-anchor] .photo-frame"),
          labels: {
            leads: host.querySelector("[data-label-leads]"),
            revenue: host.querySelector("[data-label-revenue]"),
            milestones: Array.from(host.querySelectorAll("[data-ms-label]")),
          },
        });
      });
    }

    const globe = document.querySelector<HTMLElement>("[data-globe]");
    if (globe) {
      const io = new IntersectionObserver(
        async ([entry]) => {
          if (!entry.isIntersecting) return;
          io.disconnect();
          const { mount } = await import("../scripts/globe.js");
          const markets = JSON.parse(globe.dataset.markets || "[]");
          mount(globe, markets, Array.from(globe.querySelectorAll<HTMLElement>("[data-g-label]")));
        },
        { rootMargin: "600px 0px" },
      );
      io.observe(globe);
    }
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    background: var(--signal);
    color: var(--ink);
    padding-block: calc(var(--nav-h) + clamp(2.5rem, 7vw, 5rem)) clamp(5rem, 10vw, 7.5rem);
    overflow: hidden;
    min-height: min(100svh, 62rem);
    display: flex;
    align-items: center;
  }
  .hero > .wrap {
    width: 100%;
  }
  .hero-scene {
    position: absolute;
    inset: 0;
    z-index: var(--z-scene);
    pointer-events: none;
  }
  .hero-scene canvas {
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1.4s ease-out;
  }
  .hero-scene:global(.scene-on) canvas {
    opacity: 1;
  }
  .scene-label {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 0.72rem;
    font-weight: 800;
    font-stretch: 115%;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    white-space: nowrap;
    opacity: 0;
    translate: -50% -50%;
    transition: opacity 0.6s ease-out 1.2s;
  }
  .label-leads {
    background: var(--ink);
    color: var(--on-ink);
  }
  .label-revenue {
    background: var(--on-ink);
    color: var(--ink);
    border: 2px solid var(--ink);
  }
  .hero-scene:global(.scene-on) .scene-label {
    opacity: 1;
  }
  @media (max-width: 59.99rem) {
    .scene-label {
      display: none;
    }
  }
  .hero-grid {
    position: relative;
    z-index: var(--z-content);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .hero-title {
    font-weight: 900;
    font-stretch: 125%;
    font-size: clamp(2.15rem, 6.2vw, 5rem);
    line-height: 0.96;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    max-width: 12ch;
  }
  /* Each word rises out of its own mask and widens as it lands */
  .wm {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.06em;
    margin-bottom: -0.06em;
    vertical-align: top;
  }
  .w {
    display: inline-block;
  }
  .js .w {
    transform: translateY(105%);
    font-stretch: 75%;
  }
  .js.loaded .w {
    transform: none;
    font-stretch: 125%;
    transition:
      transform 0.9s var(--ease-out),
      font-stretch 1.3s var(--ease-out);
    transition-delay: calc(var(--i) * 70ms + 60ms);
  }
  .hl .wm {
    background: var(--ink);
    color: var(--on-ink);
    padding-inline: 0.1em;
  }

  .hero-sub {
    max-width: 50ch;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.55;
    font-weight: 500;
    color: var(--ink);
    text-wrap: pretty;
  }
  .hero-sub strong {
    font-weight: 800;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.2rem;
  }
  .hero .btn-secondary {
    border-color: var(--ink);
  }
  .hero .btn-primary:hover,
  .hero .btn-primary:focus-visible {
    box-shadow: 0 0 0 4px var(--on-ink);
  }

  .hero-photo {
    position: relative;
    margin: 1.5rem auto 1rem;
    width: min(19rem, 78%);
  }
  .photo-frame {
    border: var(--line-bold);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 10px 10px 0 var(--ink);
    background: var(--ink);
    rotate: -2deg;
  }
  .photo-frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero-sticker {
    position: absolute;
    top: -1.3rem;
    right: -1.2rem;
    transform: rotate(5deg);
  }
  .hero-badge {
    position: absolute;
    bottom: -2.4rem;
    left: -2.2rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .hero-sticker,
      .hero-badge {
        animation: hero-drift linear both;
        animation-timeline: scroll();
        animation-range: 0 100vh;
      }
      .hero-badge {
        animation-name: hero-drift-deep;
      }
    }
  }
  @keyframes hero-drift {
    to {
      translate: 0 30px;
    }
  }
  @keyframes hero-drift-deep {
    to {
      translate: 0 56px;
    }
  }
  @media (min-width: 60rem) {
    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.9fr);
      grid-template-areas:
        "title photo"
        "sub   photo"
        "cta   photo";
      column-gap: clamp(3rem, 7vw, 7rem);
      row-gap: 1.8rem;
      align-items: start;
    }
    .hero-title {
      grid-area: title;
    }
    .hero-sub {
      grid-area: sub;
    }
    .hero-actions {
      grid-area: cta;
    }
    .hero-photo {
      grid-area: photo;
      align-self: center;
      margin: 0;
      width: min(22rem, 100%);
      justify-self: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .js .w {
      transform: none;
      font-stretch: 125%;
    }
    .hero-scene canvas,
    .scene-label {
      transition: none;
    }
  }

  /* ---------- Hero option A: growth terrain (light) ---------- */
  .hero--terrain {
    background: var(--base);
    min-height: min(100svh, 64rem);
  }
  .hero--terrain .btn-primary:hover,
  .hero--terrain .btn-primary:focus-visible {
    box-shadow: 0 0 0 4px var(--amber);
  }
  @media (min-width: 60rem) {
    .hero--terrain .hero-scene canvas {
      -webkit-mask-image: linear-gradient(90deg, transparent 22%, #000 58%);
      mask-image: linear-gradient(90deg, transparent 22%, #000 58%);
    }
  }
  .hero--terrain .hero-sub {
    color: var(--ink-2);
  }
  .hero--terrain .hero-sub strong {
    color: var(--ink);
  }
  @media (max-width: 59.99rem) {
    .hero--terrain {
      padding-bottom: 62vw;
    }
    .hero--terrain .hero-scene canvas {
      -webkit-mask-image: linear-gradient(180deg, transparent 58%, #000 78%);
      mask-image: linear-gradient(180deg, transparent 58%, #000 78%);
    }
  }

  /* ---------- Hero option B: revenue curve (dark) ---------- */
  .hero--curve {
    background: var(--ink);
    color: var(--on-ink);
    min-height: min(100svh, 62rem);
  }
  .hero--curve .hl .wm {
    background: var(--signal);
    color: var(--ink);
  }
  .hero--curve .hero-sub {
    color: var(--on-ink-2);
  }
  .hero--curve .hero-sub strong {
    color: var(--on-ink);
  }
  .hero--curve .btn-primary {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--ink);
  }
  .hero--curve .btn-primary:hover,
  .hero--curve .btn-primary:focus-visible {
    box-shadow: 0 0 0 4px var(--amber);
  }
  .hero--curve .btn-secondary {
    border-color: var(--on-ink);
    color: var(--on-ink);
  }
  .hero--curve .btn-secondary:hover,
  .hero--curve .btn-secondary:focus-visible {
    background: var(--on-ink);
    color: var(--ink);
  }
  .hero--curve .cv-link {
    color: var(--on-ink);
    text-decoration-color: var(--signal);
  }
  .hero--curve :focus-visible {
    outline-color: var(--amber);
  }
  .hero--curve .hero-sub {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
  }
  .avatar {
    flex: none;
    width: 4.2rem;
    height: 4.2rem;
    margin-top: 0.3rem;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--signal);
  }
  .avatar :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ms-label {
    background: var(--on-ink);
    color: var(--ink);
    translate: -50% calc(-100% - 1.1rem);
    transition: opacity 0.4s ease-out;
    font-size: 0.74rem;
  }
  .hero--curve .hero-scene:global(.scene-on) .ms-label {
    opacity: 0;
  }
  @media (max-width: 59.99rem) {
    .hero--curve {
      padding-bottom: 88vw;
    }
    .hero--curve .ms-label {
      display: inline-block;
      font-size: 0.6rem;
      padding: 0.2rem 0.45rem;
    }
  }

  /* ---------- Work ---------- */
  .work {
    padding-block: clamp(5rem, 11vw, 8.5rem) clamp(4rem, 9vw, 7rem);
  }

  /* ---------- Services: sticky stacked panels ---------- */
  .services {
    padding-block: clamp(4rem, 9vw, 7rem);
    background: var(--base-2);
    border-top: var(--line);
    perspective: 1400px;
  }
  .svc-stack {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 3vw, 1.5rem);
  }
  .svc {
    position: sticky;
    top: calc(var(--nav-h) + 1rem + var(--k) * 1.1rem);
    min-height: clamp(15rem, 42vh, 22rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: var(--line);
    border-radius: 14px;
    background: var(--base);
    transform-origin: 50% 0%;
    will-change: transform;
  }
  .svc-1 {
    background: var(--signal);
  }
  .svc-2 {
    background: var(--amber);
  }
  .svc-3 {
    background: var(--ink);
    color: var(--on-ink);
  }
  .svc dt {
    font-size: clamp(1.7rem, 4.6vw, 3.4rem);
    text-transform: uppercase;
    max-width: 14ch;
  }
  .svc dd {
    margin: 0;
    max-width: 46ch;
    font-size: clamp(1.02rem, 1.5vw, 1.2rem);
    line-height: 1.55;
    font-weight: 500;
    text-wrap: pretty;
    align-self: flex-end;
  }
  .svc-3 dd {
    color: var(--on-ink-2);
  }

  /* ---------- Testimonials ---------- */
  .testimonials {
    padding-block: clamp(5rem, 11vw, 8rem);
    overflow: hidden;
  }
  .quote-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(2.2rem, 5vw, 3.2rem);
  }
  .quote-stack > :global(.quote-block) {
    max-width: 48rem;
  }
  @media (min-width: 60rem) {
    .quote-stack > :global(.quote-block:nth-child(2)) {
      align-self: flex-end;
    }
    .quote-stack > :global(.quote-block:nth-child(3)) {
      align-self: center;
      max-width: 38rem;
    }
  }

  /* ---------- Remote readiness + globe ---------- */
  .remote {
    background: var(--base-2);
    border-top: var(--line);
    padding-block: clamp(5rem, 10vw, 8rem);
    overflow: hidden;
  }
  .remote-grid {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .remote-copy {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .remote-copy .section-title {
    margin-bottom: 0;
    max-width: 16ch;
    font-size: clamp(2rem, 4.6vw, 3.6rem);
  }
  .remote-copy p {
    max-width: 52ch;
    color: var(--ink-2);
    font-size: 1.08rem;
    text-wrap: pretty;
  }
  .globe {
    position: relative;
    width: 100%;
    max-width: 36rem;
    aspect-ratio: 1;
    margin-inline: auto;
    cursor: grab;
    touch-action: pan-y;
    border-radius: 50%;
  }
  .globe:global(.is-dragging) {
    cursor: grabbing;
  }
  .globe canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
  .g-label {
    position: absolute;
    left: 0;
    top: 0;
    translate: 10px -130%;
    font-size: 0.72rem;
    font-weight: 800;
    font-stretch: 112%;
    text-transform: uppercase;
