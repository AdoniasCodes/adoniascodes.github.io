---
const year = new Date().getFullYear();
---

<footer class="footer-cta">
  <div class="wrap">
    <div class="footer-lead" data-reveal>
      <h2 class="display">Have a growth problem worth solving?</h2>
      <a class="btn btn-talk" href="/contact/">Let's talk</a>
    </div>
    <div class="footer-links" data-reveal style="--d:100ms">
      <a href="mailto:adoniasnigussie@gmail.com">adoniasnigussie@gmail.com</a>
      <a href="https://www.linkedin.com/in/adoniasn/" rel="noopener">LinkedIn</a>
    </div>
    <div class="footer-base">
      <span>&copy; {year} Adonias Nigussie &middot; Addis Ababa, Ethiopia</span>
      <span>Remote-ready, worldwide</span>
    </div>
  </div>
</footer>

<style>
  .footer-cta {
    background: var(--cobalt);
    color: var(--sand);
    border-top: var(--line);
    padding-block: clamp(4rem, 9vw, 7rem) 0;
  }
  .footer-cta h2 {
    font-size: clamp(2.2rem, 6vw, 4.4rem);
    text-transform: uppercase;
    line-height: 1.05;
    max-width: 16ch;
  }
  .footer-lead {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .footer-links {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
    font-weight: 600;
  }
  .footer-links a {
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
    text-decoration-color: var(--marigold);
  }
  .footer-links a:hover {
    color: var(--marigold);
  }
  .footer-cta :global(:focus-visible) {
    outline-color: var(--marigold);
  }
  .footer-base {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    border-top: 2px solid rgba(245, 237, 220, 0.35);
    padding-block: 1.1rem;
    font-size: 0.85rem;
    color: #d8dcf5;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
  }
  @media (min-width: 60rem) {
    .footer-lead {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      gap: 3rem;
    }
    .footer-lead .btn-talk {
      align-self: flex-end;
      margin-bottom: 0.5rem;
    }
  }
</style>
