---
const year = new Date().getFullYear();
---

<footer class="footer-cta">
  <div class="wrap">
    <div class="footer-lead" data-reveal>
      <h2 class="display" data-stretch>Have a growth problem worth solving?</h2>
      <a class="btn btn-signal" href="/contact/">Let's talk <span class="arrow" aria-hidden="true">&rarr;</span></a>
    </div>
    <div class="footer-links" data-reveal style="--d:100ms">
      <a href="mailto:adoniasnigussie@gmail.com">adoniasnigussie@gmail.com</a>
      <a href="https://www.linkedin.com/in/adoniasn/" rel="noopener">LinkedIn</a>
    </div>
  </div>
  <div class="giant-wrap" aria-hidden="true">
    <p class="giant" data-giant>Adonias Nigussie</p>
  </div>
  <div class="wrap">
    <div class="footer-base">
      <span>&copy; {year} Adonias Nigussie &middot; Addis Ababa, Ethiopia</span>
      <span>Remote-ready, worldwide</span>
    </div>
  </div>
</footer>

<style>
  .footer-cta {
    position: relative;
    background: var(--ink);
    color: var(--on-ink);
    padding-block: clamp(5rem, 11vw, 8rem) 0;
    overflow: hidden;
  }
  .footer-cta h2 {
    font-size: clamp(2.3rem, 6.6vw, 5rem);
    text-transform: uppercase;
    max-width: 14ch;
  }
  .footer-lead {
    display: flex;
    flex-direction: column;
    gap: 2.2rem;
  }
  .footer-links {
    margin-top: 2.8rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
    font-weight: 650;
    font-size: 1.05rem;
  }
  .footer-links a {
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
    text-decoration-color: var(--signal);
    overflow-wrap: anywhere;
  }
  .footer-links a:hover {
    color: var(--amber);
  }
  .footer-cta :global(:focus-visible) {
    outline-color: var(--amber);
  }
  .giant-wrap {
    margin-top: clamp(3rem, 8vw, 5rem);
    overflow: hidden;
    border-top: 1px solid var(--rule-ink);
  }
  .giant {
    font-weight: 900;
    font-stretch: 125%;
    font-size: 6.6vw;
    line-height: 0.82;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    white-space: nowrap;
    text-align: center;
    color: var(--signal);
    padding-top: 0.12em;
    margin: 0;
  }
  .footer-base {
    border-top: 1px solid var(--rule-ink);
    padding-block: 1.1rem 1.4rem;
    font-size: 0.85rem;
    color: var(--on-ink-2);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
  }
  @media (min-width: 60rem) {
    .footer-lead {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      gap: 3rem;
    }
    .footer-lead .btn-signal {
      flex: none;
      margin-bottom: 0.5rem;
    }
  }
</style>
