---
interface Props {
  tone?: "signal" | "base";
}

const { tone = "base" } = Astro.props;

const links = [
  { href: "/work/", label: "Work" },
  { href: "/blog/", label: "Blog" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class:list={["site-nav", `tone-${tone}`]} data-nav>
  <nav class="wrap" aria-label="Main">
    <a class="wordmark" href="/">
      <span class="mark" aria-hidden="true">AN</span>
      <span class="wordmark-name">Adonias Nigussie</span>
    </a>
    <ul>
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a class="nav-cv" href="/Adonias-Nigussie-CV.pdf" download>
          CV <span aria-hidden="true">&#8595;</span>
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-nav);
    height: var(--nav-h);
    display: flex;
    align-items: center;
    background: var(--base);
    border-bottom: 2px solid transparent;
    transition:
      background-color 0.35s ease-out,
      border-color 0.35s ease-out,
      translate 0.45s var(--ease-out);
  }
  /* On the home hero the bar melts into the vermilion field */
  .site-nav.tone-signal {
    background: transparent;
  }
  .site-nav.is-scrolled {
    background: var(--base);
    border-bottom-color: var(--ink);
  }
  /* Hides while reading downward, returns on any upward scroll */
  .site-nav.is-hidden {
    translate: 0 -100%;
  }
  .site-nav .wrap {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--ink);
  }
  .mark {
    display: inline-grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--on-ink);
    font-weight: 900;
    font-stretch: 125%;
    font-size: 0.78rem;
    letter-spacing: -0.02em;
    transition: transform 0.5s var(--ease-out);
  }
  .wordmark:hover .mark,
  .wordmark:focus-visible .mark {
    transform: rotate(-360deg);
  }
  .wordmark-name {
    font-weight: 860;
    font-stretch: 125%;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  ul {
    display: flex;
    align-items: center;
    gap: clamp(0.3rem, 2vw, 1.4rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  ul a {
    position: relative;
    display: inline-block;
    font-weight: 650;
    font-size: 0.93rem;
    text-decoration: none;
    padding: 0.5rem 0.35rem;
  }
  ul a:not(.nav-cv)::after {
    content: "";
    position: absolute;
    left: 0.35rem;
    right: 0.35rem;
    bottom: 0.3rem;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s var(--ease-out);
  }
  ul a:hover::after,
  ul a[aria-current="page"]::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .nav-cv {
    font-weight: 750 !important;
    font-stretch: 115%;
    font-size: 0.82rem !important;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: var(--ink);
    color: var(--on-ink);
    border-radius: 999px;
    padding: 0.5rem 0.95rem !important;
    transition: box-shadow 0.2s ease-out;
  }
  .nav-cv:hover,
  .nav-cv:focus-visible {
    box-shadow: 0 0 0 3px var(--amber);
  }

  /* Name stays in the accessibility tree on phones, only the AN mark shows */
  @media (max-width: 34rem) {
    .wordmark-name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    ul {
      gap: 0.1rem;
    }
    ul a {
      font-size: 0.86rem;
      padding-inline: 0.3rem;
    }
    .nav-cv {
      padding: 0.45rem 0.7rem !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-nav,
    .mark,
    ul a::after {
      transition: none;
    }
  }
</style>
