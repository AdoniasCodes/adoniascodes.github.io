---
/* Spinning circular-text badge: a 3D-feeling hero artifact.
   Pure CSS rotation; pauses under prefers-reduced-motion. */
---

<div class="orbit-badge" aria-hidden="true">
  <svg viewBox="0 0 200 200">
    <defs>
      <path
        id="orbit-circle"
        d="M100,100 m-74,0 a74,74 0 1,1 148,0 a74,74 0 1,1 -148,0"
      ></path>
    </defs>
    <text class="orbit-text">
      <textPath href="#orbit-circle" textLength="464">
        STRATEGY &#183; SYSTEMS &#183; GROWTH &#183; STRATEGY &#183; SYSTEMS &#183; GROWTH &#183;
      </textPath>
    </text>
  </svg>
  <span class="orbit-core display">&#10035;</span>
</div>

<style>
  .orbit-badge {
    position: relative;
    width: clamp(7rem, 13vw, 9.5rem);
    aspect-ratio: 1;
    background: var(--ink);
    border: 2px solid var(--ink);
    border-radius: 50%;
    display: grid;
    place-items: center;
  }
  .orbit-badge svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: orbit-spin 24s linear infinite;
  }
  .orbit-text {
    font-family: var(--font);
    font-weight: 800;
    font-stretch: 115%;
    font-size: 15.5px;
    letter-spacing: 0.14em;
    fill: var(--on-ink);
  }
  .orbit-core {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    line-height: 1;
    color: var(--amber);
  }
  @keyframes orbit-spin {
    to {
      transform: rotate(1turn);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .orbit-badge svg {
      animation: none;
    }
  }
</style>
